{{!
    @template local_issuebadge/management_dashboard

    IssueBadge management dashboard template

    Context variables required for this template:
    * badgecount - Number of cached badges
    * issuedcount - Number of issued badges
    * coursecount - Number of configured courses
    * apiconfigured - Whether API is configured
    * menucards - Array of menu card items
    * steps - How it works steps
    * configuredcourses - List of configured courses

    Example context (json):
    {
        "badgecount": 5,
        "issuedcount": 10,
        "coursecount": 3,
        "apiconfigured": true,
        "hasconfiguredcourses": true,
        "menucards": [
            {"icon": "fa-certificate", "title": "Manage Badges", "description": "View and refresh badges", "url": "#", "btnclass": "btn-primary"}
        ],
        "steps": [
            {"number": 1, "title": "Configure API", "description": "Enter your API key"}
        ],
        "configuredcourses": [
            {"coursename": "Course 1", "badgename": "Badge 1", "triggertype": "Completion", "enabled": true, "configureurl": "#"}
        ]
    }
}}
<div class="local_issuebadge_dashboard">

    {{! API Warning }}
    {{^apiconfigured}}
    <div class="alert alert-warning mb-4">
        <i class="fa fa-exclamation-triangle mr-2"></i>
        <strong>{{#str}}warning{{/str}}:</strong> {{#str}}error_noapi, local_issuebadge{{/str}}
    </div>
    {{/apiconfigured}}

    {{! Stats Cards }}
    <div class="row mb-4">
        <div class="col-md-4 mb-3">
            <div class="card text-center h-100 border-primary">
                <div class="card-body">
                    <i class="fa fa-certificate fa-2x text-primary mb-2"></i>
                    <h3 class="card-title mb-0">{{badgecount}}</h3>
                    <p class="card-text text-muted">{{#str}}badges, local_issuebadge{{/str}}</p>
                </div>
            </div>
        </div>
        <div class="col-md-4 mb-3">
            <div class="card text-center h-100 border-success">
                <div class="card-body">
                    <i class="fa fa-check-circle fa-2x text-success mb-2"></i>
                    <h3 class="card-title mb-0">{{issuedcount}}</h3>
                    <p class="card-text text-muted">{{#str}}badgesissuedtotal, local_issuebadge{{/str}}</p>
                </div>
            </div>
        </div>
        <div class="col-md-4 mb-3">
            <div class="card text-center h-100 border-info">
                <div class="card-body">
                    <i class="fa fa-graduation-cap fa-2x text-info mb-2"></i>
                    <h3 class="card-title mb-0">{{coursecount}}</h3>
                    <p class="card-text text-muted">{{#str}}coursesconfigured, local_issuebadge{{/str}}</p>
                </div>
            </div>
        </div>
    </div>

    {{! Menu Cards }}
    <div class="row mb-4">
        {{#menucards}}
        <div class="col-md-6 col-lg-3 mb-3">
            <div class="card h-100">
                <div class="card-body text-center">
                    <i class="fa {{icon}} fa-3x text-muted mb-3"></i>
                    <h5 class="card-title">{{title}}</h5>
                    <p class="card-text small text-muted">{{description}}</p>
                </div>
                <div class="card-footer bg-transparent border-0 text-center pb-3">
                    <a href="{{url}}" class="btn {{btnclass}}">{{title}}</a>
                </div>
            </div>
        </div>
        {{/menucards}}
    </div>

    {{! How It Works Section }}
    <div class="card mb-4">
        <div class="card-header bg-light">
            <h4 class="mb-0"><i class="fa fa-question-circle mr-2"></i>{{#str}}howitworks, local_issuebadge{{/str}}</h4>
        </div>
        <div class="card-body">
            <div class="row">
                {{#steps}}
                <div class="col-md-6 col-lg-3 mb-3">
                    <div class="d-flex">
                        <div class="mr-3">
                            <span class="badge badge-primary badge-pill" style="font-size: 1.2rem; width: 2rem; height: 2rem; line-height: 1.5rem;">{{number}}</span>
                        </div>
                        <div>
                            <h6 class="mb-1">{{title}}</h6>
                            <p class="text-muted small mb-0">{{description}}</p>
                        </div>
                    </div>
                </div>
                {{/steps}}
            </div>
        </div>
    </div>

    {{! Course Configuration Tip }}
    <div class="card mb-4 border-info">
        <div class="card-header bg-info text-white">
            <h5 class="mb-0"><i class="fa fa-lightbulb-o mr-2"></i>{{#str}}coursesetuptip, local_issuebadge{{/str}}</h5>
        </div>
        <div class="card-body">
            <p class="mb-2">{{#str}}coursesetuptip_desc, local_issuebadge{{/str}}</p>
            <code>{{#str}}coursesetuptip_url, local_issuebadge{{/str}}</code>

            <hr class="my-3">
            <h6><i class="fa fa-cogs mr-2"></i>{{#str}}triggeroptions, local_issuebadge{{/str}}</h6>
            <ul class="mb-0">
                <li><strong>{{#str}}trigger_manual, local_issuebadge{{/str}}</strong> - {{#str}}triggeroptions_manual, local_issuebadge{{/str}}</li>
                <li><strong>{{#str}}trigger_completion, local_issuebadge{{/str}}</strong> - {{#str}}triggeroptions_completion, local_issuebadge{{/str}}</li>
                <li><strong>{{#str}}trigger_quiz, local_issuebadge{{/str}}</strong> - {{#str}}triggeroptions_quiz, local_issuebadge{{/str}}</li>
            </ul>
        </div>
    </div>

    {{! Configured Courses }}
    {{#hasconfiguredcourses}}
    <div class="card">
        <div class="card-header bg-light">
            <h5 class="mb-0"><i class="fa fa-graduation-cap mr-2"></i>{{#str}}configuredcourses, local_issuebadge{{/str}}</h5>
        </div>
        <div class="card-body p-0">
            <table class="table table-striped mb-0">
                <thead>
                    <tr>
                        <th>{{#str}}course{{/str}}</th>
                        <th>{{#str}}badge, local_issuebadge{{/str}}</th>
                        <th>{{#str}}triggertype, local_issuebadge{{/str}}</th>
                        <th>{{#str}}status{{/str}}</th>
                        <th>{{#str}}actions, local_issuebadge{{/str}}</th>
                    </tr>
                </thead>
                <tbody>
                    {{#configuredcourses}}
                    <tr>
                        <td>{{coursename}}</td>
                        <td>{{badgename}}</td>
                        <td>{{triggertype}}</td>
                        <td>
                            {{#enabled}}
                            <span class="badge badge-success">{{#str}}enabled, local_issuebadge{{/str}}</span>
                            {{/enabled}}
                            {{^enabled}}
                            <span class="badge badge-secondary">{{#str}}disabled, local_issuebadge{{/str}}</span>
                            {{/enabled}}
                        </td>
                        <td>
                            <a href="{{configureurl}}" class="btn btn-sm btn-outline-primary">
                                <i class="fa fa-cog"></i> {{#str}}configure, local_issuebadge{{/str}}
                            </a>
                        </td>
                    </tr>
                    {{/configuredcourses}}
                </tbody>
            </table>
        </div>
    </div>
    {{/hasconfiguredcourses}}

</div>
