<?xml version="1.0" encoding="UTF-8" ?>
<XMLDB PATH="local/issuebadge/db" VERSION="20250124" COMMENT="XMLDB file for Moodle local/issuebadge">
  <TABLES>
    <TABLE NAME="local_issuebadge_badges" COMMENT="Cached badges from IssueBadge API">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="badge_id" TYPE="char" LENGTH="255" NOTNULL="true" SEQUENCE="false" COMMENT="Badge ID from IssueBadge API"/>
        <FIELD NAME="name" TYPE="char" LENGTH="255" NOTNULL="true" SEQUENCE="false" COMMENT="Badge name"/>
        <FIELD NAME="description" TYPE="text" NOTNULL="false" SEQUENCE="false" COMMENT="Badge description"/>
        <FIELD NAME="image_url" TYPE="text" NOTNULL="false" SEQUENCE="false" COMMENT="Badge image URL"/>
        <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="timemodified" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="badge_id" UNIQUE="true" FIELDS="badge_id"/>
      </INDEXES>
    </TABLE>
    <TABLE NAME="local_issuebadge_issues" COMMENT="Stores issued badge records">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="userid" TYPE="int" LENGTH="10" NOTNULL="false" DEFAULT="0" SEQUENCE="false" COMMENT="User who received the badge (0 if external)"/>
        <FIELD NAME="recipient_name" TYPE="char" LENGTH="255" NOTNULL="false" SEQUENCE="false" COMMENT="Recipient name (for external users)"/>
        <FIELD NAME="recipient_email" TYPE="char" LENGTH="255" NOTNULL="false" SEQUENCE="false" COMMENT="Recipient email (for external users)"/>
        <FIELD NAME="badge_id" TYPE="char" LENGTH="255" NOTNULL="true" SEQUENCE="false" COMMENT="Badge ID from IssueBadge"/>
        <FIELD NAME="issue_id" TYPE="char" LENGTH="255" NOTNULL="true" SEQUENCE="false" COMMENT="Issue ID from IssueBadge API"/>
        <FIELD NAME="public_url" TYPE="text" NOTNULL="false" SEQUENCE="false" COMMENT="Public URL to view the badge"/>
        <FIELD NAME="courseid" TYPE="int" LENGTH="10" NOTNULL="false" DEFAULT="0" SEQUENCE="false" COMMENT="Course ID if issued in course context"/>
        <FIELD NAME="issuerby" TYPE="int" LENGTH="10" NOTNULL="false" DEFAULT="0" SEQUENCE="false" COMMENT="User who issued the badge"/>
        <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false" COMMENT="Timestamp when badge was issued"/>
        <FIELD NAME="timemodified" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false" COMMENT="Timestamp when record was modified"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
        <KEY NAME="userid" TYPE="foreign" FIELDS="userid" REFTABLE="user" REFFIELDS="id"/>
        <KEY NAME="courseid" TYPE="foreign" FIELDS="courseid" REFTABLE="course" REFFIELDS="id"/>
        <KEY NAME="issuerby" TYPE="foreign" FIELDS="issuerby" REFTABLE="user" REFFIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="issue_id" UNIQUE="true" FIELDS="issue_id"/>
        <INDEX NAME="badge_id" UNIQUE="false" FIELDS="badge_id"/>
      </INDEXES>
    </TABLE>
    <TABLE NAME="local_issuebadge_course" COMMENT="Badge configuration for courses">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="courseid" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false" COMMENT="Course ID"/>
        <FIELD NAME="badge_id" TYPE="char" LENGTH="255" NOTNULL="true" SEQUENCE="false" COMMENT="Badge ID to issue"/>
        <FIELD NAME="trigger_type" TYPE="char" LENGTH="50" NOTNULL="true" DEFAULT="manual" SEQUENCE="false" COMMENT="Trigger type: manual, completion, quiz"/>
        <FIELD NAME="quiz_id" TYPE="int" LENGTH="10" NOTNULL="false" DEFAULT="0" SEQUENCE="false" COMMENT="Quiz ID for grade-based trigger"/>
        <FIELD NAME="passing_grade" TYPE="int" LENGTH="3" NOTNULL="false" DEFAULT="70" SEQUENCE="false" COMMENT="Minimum passing grade percentage"/>
        <FIELD NAME="enabled" TYPE="int" LENGTH="1" NOTNULL="true" DEFAULT="1" SEQUENCE="false" COMMENT="Whether auto-issue is enabled"/>
        <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="timemodified" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
        <KEY NAME="courseid" TYPE="foreign-unique" FIELDS="courseid" REFTABLE="course" REFFIELDS="id"/>
      </KEYS>
    </TABLE>
  </TABLES>
</XMLDB>
